{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "venxpos",
  "version": "0.1.0",
  "identifier": "com.venxpos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VenxPos — Punto de Venta",
        "width": 1280,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://beacnoxukkoellhecofm.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Venx Tecnología SAS",
    "shortDescription": "Sistema de Punto de Venta offline-first para supermercados, minimercados y autoservicios colombianos",
    "copyright": "Copyright 2026 Venx Tecnología SAS. Todos los derechos reservados.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "wix": {
        "language": "es-CO"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "sql": {
    }
  }
}
